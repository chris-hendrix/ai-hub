{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "default_agent": "plan",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode-go/glm-5.2",
      "permission": {
        "task": {
          "view": "allow"
        }
      }
    },
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
