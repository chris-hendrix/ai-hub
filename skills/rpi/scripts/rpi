#!/usr/bin/env bash
set -euo pipefail

# rpi — deterministic helpers for the rpi skill
# Usage:
#   rpi write  --type {plan|review|implement|handoff} --topic "..." [--ticket N]  # body on stdin
#   rpi status <plan-file> <planned|in-progress|completed>
#   rpi next   <plan-file>            # first unchecked task + its RED/GREEN/CHECK block
#   rpi done   <plan-file> <task-id>  # mark **Task <id>** complete
#   rpi pickup [path] [--list]        # resolve a handoff: latest, or given path

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# repo root is two levels up from skills/rpi/scripts
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

kebab_case() {
  local s="$1"
  # lowercase, replace non-alnum with -, collapse, trim
  echo "$s" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

cmd_write() {
  local type="" topic="" ticket="" status=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type)     type="$2"; shift 2 ;;
      --topic)    topic="$2"; shift 2 ;;
      --ticket)   ticket="$2"; shift 2 ;;
      --status)   status="$2"; shift 2 ;;
      -h|--help)  usage_write; exit 0 ;;
      *) echo "rpi write: unknown option: $1" >&2; usage_write >&2; exit 1 ;;
    esac
  done

  if [[ -z "$type" || -z "$topic" ]]; then
    echo "rpi write: --type and --topic are required" >&2
    usage_write >&2
    exit 1
  fi

  local subdir front_status=""
  case "$type" in
    
    plan)         subdir="plans"; front_status="${status:-planned}" ;;
    review)      subdir="reviews" ;;
    implement)    subdir="implementations" ;;
    handoff)      subdir="handoffs"; front_status="${status:-handed-off}" ;;
    *) echo "rpi write: unknown --type: $type (expected plan|review|implement|handoff)" >&2; exit 1 ;;
  esac

  local date
  date="$(date +%Y-%m-%d)"
  local slug
  slug="$(kebab_case "$topic")"

  # handoff session chain: inherit from newest existing handoff, append current session
  local session_chain=""
  if [[ "$type" == "handoff" ]]; then
    local hdir="${REPO_ROOT}/.rpi/handoffs"
    local newest
    newest="$(ls -1 "$hdir" 2>/dev/null | sort -r | head -1 || true)"
    if [[ -n "$newest" ]]; then
      session_chain="$(awk '/^---$/{c++;next} c==1 && /^sessions:/{f=1;next} f && /^- /{sub(/^- +/,""); print; next} {f=0}' "$hdir/$newest")"
    fi
    local sid="${PI_SESSION_ID:-}"
    if [[ -n "$sid" ]]; then
      if [[ -n "$session_chain" ]] && ! grep -qx "$sid" <<<"$session_chain"; then
        session_chain="$session_chain
$sid"
      elif [[ -z "$session_chain" ]]; then
        session_chain="$sid"
      fi
    fi
  fi

  local filename
  if [[ -n "$ticket" ]]; then
    local ticket_slug
    ticket_slug="$(kebab_case "$ticket")"
    filename="${date}-$(date +%H%M%S)-${ticket_slug}-${slug}.md"
  else
    filename="${date}-$(date +%H%M%S)-${slug}.md"
  fi

  local body
  body="$(cat)"

  local outdir="${REPO_ROOT}/.rpi/${subdir}"
  mkdir -p "$outdir"
  local outpath="${outdir}/${filename}"

  {
    echo "---"
    echo "type: ${type}"
    echo "date: ${date}"
    if [[ -n "$topic" ]]; then
      echo "topic: ${topic}"
    fi
    if [[ -n "$ticket" ]]; then
      echo "ticket: ${ticket}"
    fi
    if [[ -n "$front_status" ]]; then
      echo "status: ${front_status}"
    fi
    if [[ -n "$session_chain" ]]; then
      echo "sessions:"
      while IFS= read -r s; do echo "- ${s}"; done <<<"$session_chain"
    fi
    echo "---"
    echo ""
    printf "%s" "$body"
    # ensure trailing newline
    if [[ -n "$body" && "${body: -1}" != $'\n' ]]; then
      echo ""
    fi
  } > "$outpath"

  echo "$outpath"
}

cmd_status() {
  if [[ $# -ne 2 ]]; then
    echo "Usage: rpi status <plan-file> <planned|in-progress|completed|handed-off>" >&2
    exit 1
  fi
  local file="$1" new_status="$2"
  # resolve relative to repo root if not absolute
  if [[ "$file" != /* ]]; then
    file="${REPO_ROOT}/${file#.}"
    # handle leading ./ or bare relative
    file="$(realpath -m "$file" 2>/dev/null || echo "$file")"
    # fallback: try as given relative to repo
    if [[ ! -f "$file" ]]; then
      file="${REPO_ROOT}/${1}"
    fi
  fi
  if [[ ! -f "$file" ]]; then
    echo "rpi status: file not found: $1" >&2; exit 1
  fi
  # replace the status: line in frontmatter (first occurrence between --- markers)
  # use a Python one-liner for reliable YAML frontmatter handling would be overkill;
  # simple sed for the first status: line is sufficient for our frontmatter shape
  local tmp
  tmp="$(mktemp)"
  # only replace inside frontmatter (between first two --- lines)
  awk -v ns="$new_status" '
    BEGIN { in_fm=0; fm_count=0; replaced=0 }
    /^---[[:space:]]*$/ {
      fm_count++
      if (fm_count==1) in_fm=1
      else if (fm_count==2) in_fm=0
      print; next
    }
    in_fm && !replaced && /^status:/ {
      print "status: " ns
      replaced=1
      next
    }
    { print }
    END {
      if (!replaced) {
        # no status line in frontmatter — insert before closing ---
        # re-read and insert: simplest is to do a second pass if needed
        # but for now, warn
      }
    }
  ' "$file" > "$tmp"
  # if no status line was replaced, insert it before the closing ---
  if ! grep -q "^status: ${new_status}$" "$tmp"; then
    awk -v ns="$new_status" '
      BEGIN { fm_count=0 }
      /^---[[:space:]]*$/ {
        fm_count++
        if (fm_count==2 && !done) {
          print "status: " ns
          done=1
        }
        print; next
      }
      { print }
    ' "$tmp" > "${tmp}.2" && mv "${tmp}.2" "$tmp"
  fi
  mv "$tmp" "$file"
  echo "$file -> status: $new_status"
}

cmd_next() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: rpi next <plan-file>" >&2; exit 1
  fi
  local file; file="$(resolve_plan "$1")"
  # print the first unchecked task with its body (indented follow-on lines)
  awk '
    /^- \[ \] / { if (found) exit; found=1; print; next }
    found && /^[[:space:]]+[^[:space:]]/ { print; next }
    found { exit }
  ' "$file"
  if ! grep -q '^- \[ \]' "$file"; then
    echo "(all done)"
  fi
}

cmd_done() {
  if [[ $# -ne 2 ]]; then
    echo "Usage: rpi done <plan-file> <task-id>" >&2; exit 1
  fi
  local file; file="$(resolve_plan "$1")"
  local task_id="$2"
  if ! grep -Eq "^- \[ \] .*(\*\*)?[Tt]ask ${task_id}([:.]|$)" "$file"; then
    echo "rpi done: no unchecked Task ${task_id} found in $file" >&2; exit 1
  fi
  local tmp; tmp="$(mktemp)"
  awk -v tid="$task_id" '
    !done && /^- \[ \] / && $0 ~ "([*][*])?[Tt]ask " tid "([:.]|$)" {
      sub(/^- \[ \] /, "- [x] ")
      done=1
    }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
  echo "Task ${task_id} marked complete in $file"
}

resolve_plan() {
  local file="$1"
  if [[ "$file" != /* && ! -f "$file" ]]; then
    file="${REPO_ROOT}/${file}"
  fi
  if [[ ! -f "$file" ]]; then
    echo "rpi: plan file not found: $1" >&2; exit 1
  fi
  echo "$file"
}

cmd_pickup() {
  local file="" list=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list) list=1; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  if [[ "$list" -eq 1 ]]; then
    local dir="${REPO_ROOT}/.rpi/handoffs"
    if [[ ! -d "$dir" ]] || [[ -z "$(ls -A "$dir" 2>/dev/null)" ]]; then
      echo "rpi pickup: no handoffs in ${dir}" >&2; exit 1
    fi
    ls -1 "$dir" | sort -r | sed "s|^|$dir/|"
    return
  fi
  if [[ -z "$file" ]]; then
    local dir="${REPO_ROOT}/.rpi/handoffs"
    if [[ ! -d "$dir" ]] || [[ -z "$(ls -A "$dir" 2>/dev/null)" ]]; then
      echo "rpi pickup: no handoffs in ${dir}" >&2; exit 1
    fi
    file="$dir/$(ls -1 "$dir" | sort -r | head -1)"
  else
    file="$(resolve_plan "$file")"
  fi
  # inject: path header + full content
  echo "# handoff: $file"
  echo
  cat "$file"
}

usage() {
  cat <<'USAGE'
rpi — deterministic helpers for the rpi skill

Usage:
  rpi write  --type {plan|review|implement|handoff} --topic "..." [--ticket N]  # body on stdin
  rpi status <plan-file> <planned|in-progress|completed|handed-off>
  rpi next   <plan-file>            # first unchecked task + its RED/GREEN/CHECK block
  rpi done   <plan-file> <task-id>  # mark **Task <id>** complete

Examples:
  printf '# My plan\n...' | rpi write --type plan --topic "Auth refactor"
  rpi status .rpi/plans/2026-08-30-auth-refactor.md in-progress
  rpi next .rpi/plans/2026-08-30-auth-refactor.md
  rpi done .rpi/plans/2026-08-30-auth-refactor.md 2
  rpi pickup .rpi/handoffs/2026-05-24-auth-refactor.md
USAGE
}

usage_write() {
  cat <<'USAGE'
rpi write — create a .rpi document with deterministic frontmatter

  --type     one of: plan, review, implement, handoff  (required)
  --topic    human-readable topic, used for frontmatter and filename (required — a short generated title)
  --ticket   optional ticket/issue id, included in filename and frontmatter
  --status   override frontmatter status (plan→planned, handoff→handed-off by default)

Writes to .rpi/<subdir>/YYYY-MM-DD-[ticket-]kebab-topic.md and prints the path.
USAGE
}

main() {
  if [[ $# -eq 0 ]]; then usage >&2; exit 1; fi
  local cmd="$1"; shift
  case "$cmd" in
    write)  cmd_write "$@" ;;
    status) cmd_status "$@" ;;
    next)   cmd_next "$@" ;;
    done)   cmd_done "$@" ;;
    pickup) cmd_pickup "$@" ;;
    -h|--help|help) usage; exit 0 ;;
    *) echo "rpi: unknown subcommand: $cmd" >&2; usage >&2; exit 1 ;;
  esac
}

main "$@"
