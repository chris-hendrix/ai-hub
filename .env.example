# Copy to ~/.zshrc or export in your shell profile.
# opencode reads these via {env:VAR} in harness/.opencode/opencode.json

# Required for mcp:context7 (opencode.json -> mcp.context7.headers.CONTEXT7_API_KEY)
CONTEXT7_API_KEY=

# Optional: other provider/model API keys are typically managed via
# `opencode auth` or provider-specific env vars — see https://opencode.ai/docs/providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
